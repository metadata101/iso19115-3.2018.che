<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns="http://www.interlis.ch/xtf/2.4/Dictionaries_V2"
  targetNamespace="http://www.interlis.ch/xtf/2.4/Dictionaries_V2"
  xmlns:geom="http://www.interlis.ch/geometry/1.0"
  xmlns:INTERLIS="http://www.interlis.ch/xtf/2.4/INTERLIS"
  xmlns:ili2c="http://www.interlis.ch/ili2c"
  xmlns:InternationalCodes_V2="http://www.interlis.ch/xtf/2.4/InternationalCodes_V2"
  elementFormDefault="qualified" attributeFormDefault="qualified">
<xsd:annotation>
  <xsd:appinfo source="http://www.interlis.ch/ili2c/ili2cversion">5.6.9-bf16026e83f2377153b2e818a4f3838f0a423722</xsd:appinfo>
  <xsd:appinfo source="http://www.interlis.ch/ili2c">
    <ili2c:model>Dictionaries_V2</ili2c:model>
    <ili2c:modelVersion>2021-01-06</ili2c:modelVersion>
    <ili2c:modelAt>https://models.geo.admin.ch/CH/</ili2c:modelAt>
  </xsd:appinfo>
</xsd:annotation>
<xsd:import namespace="http://www.interlis.ch/geometry/1.0"/>
<xsd:import namespace="http://www.interlis.ch/xtf/2.4/INTERLIS"/>
<xsd:import namespace="http://www.interlis.ch/xtf/2.4/InternationalCodes_V2"/>
<xsd:element name="Entry" type="EntryType"/>
<xsd:complexType  name="EntryType">
  <xsd:sequence>
    <xsd:element name="Text">
      <xsd:simpleType>
        <xsd:restriction base="xsd:normalizedString">
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:element>
  </xsd:sequence>
</xsd:complexType>
<xsd:element name="Dictionary" type="DictionaryType"/>
<xsd:complexType  name="DictionaryType">
  <xsd:sequence>
    <xsd:element name="Language" type="InternationalCodes_V2:LanguageCode_ISO639_1"/>
    <xsd:element name="Entries" minOccurs="0" maxOccurs="unbounded">
      <xsd:complexType>
        <xsd:sequence>
          <xsd:element ref="Entry"/>
        </xsd:sequence>
      </xsd:complexType>
    </xsd:element>
  </xsd:sequence>
  <xsd:attribute ref="INTERLIS:tid" use="required"/>
</xsd:complexType>
<xsd:element name="Dictionaries" type="DictionariesType"/>
<xsd:complexType name="DictionariesType">
  <xsd:choice minOccurs="0" maxOccurs="unbounded">
    <xsd:element ref="Dictionary"/>
  </xsd:choice>
  <xsd:attribute ref="INTERLIS:bid" use="required"/>
  <xsd:attribute ref="INTERLIS:consistency"/>
</xsd:complexType>
</xsd:schema>
