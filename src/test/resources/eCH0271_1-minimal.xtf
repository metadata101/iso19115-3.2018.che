<?xml version="1.0" encoding="UTF-8"?>
<ili:transfer xmlns:ili="http://www.interlis.ch/xtf/2.4/INTERLIS" 
  xmlns:geom="http://www.interlis.ch/geometry/1.0" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xmlns:InternationalCodes_V2="http://www.interlis.ch/xtf/2.4/InternationalCodes_V2" 
  xmlns:Localisation_V2="http://www.interlis.ch/xtf/2.4/Localisation_V2"
  xmlns:eCH0271_1="http://www.interlis.ch/xtf/2.4/eCH0271_1">
  <ili:headersection>
    <ili:models>
      <ili:model>InternationalCodes_V2</ili:model>
      <ili:model>Localisation_V2</ili:model>
      <ili:model>eCH0271_1</ili:model>
    </ili:models>
    <ili:sender>test-minimal</ili:sender>
  </ili:headersection>
  <ili:datasection>
    <eCH0271_1:eCH0271 ili:bid="test_minimal">
      
      <!-- MD_Identifier object (referenced by CHE_MD_Metadata) -->
      <eCH0271_1:MD_Identifier ili:tid="id_001">
        <eCH0271_1:code>test-metadata-001</eCH0271_1:code>
      </eCH0271_1:MD_Identifier>
      
      <!-- CI_Responsibility (Point of Contact) -->
      <eCH0271_1:CI_Responsibility ili:tid="resp_001">
        <eCH0271_1:role>pointOfContact</eCH0271_1:role>
        <eCH0271_1:party ili:ref="org_001"/>
      </eCH0271_1:CI_Responsibility>
      
      <!-- CHE_CI_Organisation -->
      <eCH0271_1:CHE_CI_Organisation ili:tid="org_001">
        <eCH0271_1:name>Test Organisation</eCH0271_1:name>
        <eCH0271_1:organisationAcronym>TEST</eCH0271_1:organisationAcronym>
      </eCH0271_1:CHE_CI_Organisation>
      
      <!-- Main Metadata record -->
      <eCH0271_1:CHE_MD_Metadata ili:tid="metadata_001">
        <!-- Reference to MD_Identifier -->
        <eCH0271_1:metadataIdentifier ili:ref="id_001"/>
        
        <!-- Language/Locale -->
        <eCH0271_1:defaultLocale>
          <eCH0271_1:PT_Locale>
            <eCH0271_1:language>fr</eCH0271_1:language>
            <eCH0271_1:country>CH</eCH0271_1:country>
            <eCH0271_1:characterEncoding>utf8</eCH0271_1:characterEncoding>
          </eCH0271_1:PT_Locale>
        </eCH0271_1:defaultLocale>
        
        <!-- Date Info -->
        <eCH0271_1:dateInfo>
          <eCH0271_1:CI_Date>
            <eCH0271_1:date>2024-11-18T10:30:00</eCH0271_1:date>
            <eCH0271_1:dateType>revision</eCH0271_1:dateType>
          </eCH0271_1:CI_Date>
        </eCH0271_1:dateInfo>
        
        <!-- Point of Contact (reference to CI_Responsibility) -->
        <eCH0271_1:pointOfContact ili:ref="resp_001"/>
      </eCH0271_1:CHE_MD_Metadata>
      
      <!-- CHE_MD_DataIdentification (at same level, not nested) -->
      <eCH0271_1:CHE_MD_DataIdentification ili:tid="dataident_001">
        <eCH0271_1:MD_Metadata ili:ref="metadata_001"/>
        <eCH0271_1:citation>
          <eCH0271_1:CI_Citation>
            <eCH0271_1:title>Test Dataset</eCH0271_1:title>
          </eCH0271_1:CI_Citation>
        </eCH0271_1:citation>
        <eCH0271_1:abstract>A minimal test dataset for eCH0271 to ISO 19115-3:2018 CHE conversion</eCH0271_1:abstract>
      </eCH0271_1:CHE_MD_DataIdentification>
    </eCH0271_1:eCH0271>
  </ili:datasection>
</ili:transfer>
