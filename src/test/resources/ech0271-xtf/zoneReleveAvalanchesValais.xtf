                <Localisation_V2:Text>Die Geodaten sind öffentlich zugänglich. (Zugangsberechtigungsstufe A nach KGeoIG)</Localisation_V2:Text>
              </Localisation_V2:LocalisedMText>
            </Localisation_V2:LocalisedText>
          </Localisation_V2:MultilingualMText>
          <Localisation_V2:MultilingualMText>
            <Localisation_V2:LocalisedText>
              <Localisation_V2:LocalisedMText>
                <Localisation_V2:Language>fr</Localisation_V2:Language>
                <Localisation_V2:Text>Les conditions générales d'utilisation des géodonnées du Canton du Valais font foi (https://www.vs.ch/fr/web/guest/information-legale).</Localisation_V2:Text>
              </Localisation_V2:LocalisedMText>
              <Localisation_V2:LocalisedMText>
                <Localisation_V2:Language>de</Localisation_V2:Language>
                <Localisation_V2:Text>Es gelten die Nutzungsbedingungen für Geodaten des Kantons Wallis (https://www.vs.ch/de/web/guest/rechtliches).</Localisation_V2:Text>
              </Localisation_V2:LocalisedMText>
            </Localisation_V2:LocalisedText>
          </Localisation_V2:MultilingualMText>
        </eCH0271:otherConstraints>
