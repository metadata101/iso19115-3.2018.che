  <svrl:active-pattern document="" id="rule.che.appraisal-aap-duration-mandatory" name_en="{If CHE_MD_Appraisal_AAP is used then CHE_MD_Appraisal_AAP.durationOfConservation is mandatory}" name_fr="{Si CHE_MD_Appraisal_AAP est utilisé alors CHE_MD_Appraisal_AAP.durationOfConservation est obligatoire}" name="{Si CHE_MD_Appraisal_AAP est utilisé alors CHE_MD_Appraisal_AAP.durationOfConservation est obligatoire}" />
  <svrl:fired-rule context="//che:CHE_MD_Appraisal_AAP" />
  <svrl:failed-assert ref="#_" test="che:durationOfConservation/gco:Integer and normalize-space(che:durationOfConservation/gco:Integer) != ''" location="/*[local-name()='CHE_MD_Metadata']/*[local-name()='identificationInfo']/*[local-name()='CHE_MD_DataIdentification']/*[local-name()='resourceMaintenance']/*[local-name()='CHE_MD_MaintenanceInformation']/*[local-name()='appraisal']/*[local-name()='CHE_MD_Appraisal_AAP']">
    <svrl:text />
    <svrl:diagnostic-reference ref="#_" diagnostic="rule.che.appraisal-aap-duration-mandatory-failure-en" xml:lang="en">When CHE_MD_Appraisal_AAP is used, durationOfConservation is mandatory.</svrl:diagnostic-reference>
    <svrl:diagnostic-reference ref="#_" diagnostic="rule.che.appraisal-aap-duration-mandatory-failure-fr" xml:lang="fr">Lorsque CHE_MD_Appraisal_AAP est utilisé, durationOfConservation est obligatoire.</svrl:diagnostic-reference>
  </svrl:failed-assert>
  <svrl:active-pattern document="" id="rule.che.appraisal-aap-archival-value-mandatory" name_en="{If CHE_MD_Appraisal_AAP is used then CHE_MD_Appraisal_AAP.appraisalOfArchivalValue is mandatory}" name_fr="{Si CHE_MD_Appraisal_AAP est utilisé alors CHE_MD_Appraisal_AAP.appraisalOfArchivalValue est obligatoire}" name="{Si CHE_MD_Appraisal_AAP est utilisé alors CHE_MD_Appraisal_AAP.appraisalOfArchivalValue est obligatoire}" />
  <svrl:fired-rule context="//che:CHE_MD_Appraisal_AAP" />
