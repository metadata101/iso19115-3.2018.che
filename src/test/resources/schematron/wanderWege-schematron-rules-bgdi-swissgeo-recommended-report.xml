  <svrl:active-pattern document="" id="rule.che.bgdi-keyword-poc-owner-recommended" name_en="If MD_Keywords.keyword = 'BGDI Bundesgeodaten-Infrastruktur' then a pointOfContact with role 'owner' is recommended" name_fr="Si MD_Keywords.keyword = 'BGDI Bundesgeodaten-Infrastruktur' alors un pointOfContact avec le rôle 'owner' est recommandé" name="Si MD_Keywords.keyword = 'BGDI Bundesgeodaten-Infrastruktur' alors un pointOfContact avec le rôle 'owner' est recommandé" />
  <svrl:fired-rule context="//che:CHE_MD_DataIdentification[.//mri:MD_Keywords/mri:keyword/gco:CharacterString = 'BGDI Bundesgeodaten-Infrastruktur']" />
  <svrl:successful-report ref="#_" test="mri:pointOfContact/cit:CI_Responsibility/cit:role/cit:CI_RoleCode[@codeListValue='owner']" location="/*[local-name()='CHE_MD_Metadata']/*[local-name()='identificationInfo']/*[local-name()='CHE_MD_DataIdentification']">
    <svrl:text />
    <svrl:diagnostic-reference ref="#_" diagnostic="rule.che.bgdi-keyword-poc-owner-recommended-success-en" xml:lang="en">A pointOfContact with role 'owner' is present.</svrl:diagnostic-reference>
    <svrl:diagnostic-reference ref="#_" diagnostic="rule.che.bgdi-keyword-poc-owner-recommended-success-fr" xml:lang="fr">Un pointOfContact avec le rôle 'owner' est présent.</svrl:diagnostic-reference>
  </svrl:successful-report>
  <svrl:active-pattern document="" id="rule.che.bgdi-keyword-status-recommended" name_en="If MD_Keywords.keyword = 'BGDI Bundesgeodaten-Infrastruktur' then mri:status/mcc:MD_ProgressCode is recommended" name_fr="Si MD_Keywords.keyword = 'BGDI Bundesgeodaten-Infrastruktur' alors mri:status/mcc:MD_ProgressCode est recommandé" name="Si MD_Keywords.keyword = 'BGDI Bundesgeodaten-Infrastruktur' alors mri:status/mcc:MD_ProgressCode est recommandé" />
  <svrl:fired-rule context="//che:CHE_MD_DataIdentification[.//mri:MD_Keywords/mri:keyword/gco:CharacterString = 'BGDI Bundesgeodaten-Infrastruktur']" />
  <svrl:successful-report ref="#_" test="mri:status/mcc:MD_ProgressCode and normalize-space(mri:status/mcc:MD_ProgressCode/@codeListValue) != ''" location="/*[local-name()='CHE_MD_Metadata']/*[local-name()='identificationInfo']/*[local-name()='CHE_MD_DataIdentification']">
